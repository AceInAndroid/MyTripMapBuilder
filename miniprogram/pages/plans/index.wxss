.page{min-height:100vh;padding:44rpx 28rpx}.header{margin:8rpx 10rpx 35rpx}.kicker{color:#C55C4D;font-size:18rpx;font-weight:800;letter-spacing:4rpx}.title{margin-top:7rpx;font-size:48rpx;font-weight:800}.subtitle{margin-top:9rpx;color:#8C7767;font-size:22rpx}.creator{position:relative;display:flex;align-items:center;min-height:128rpx;margin-bottom:18rpx;padding:22rpx 27rpx;overflow:hidden;border:2rpx solid #E3D4BF;background:#FFFDF6}.creator.ai{color:#FFFDF6;border-radius:27rpx 42rpx 29rpx 35rpx;background:#5FAF8B}.creator.manual{border-radius:38rpx 27rpx 35rpx 29rpx}.scribble{width:65rpx;height:65rpx;margin-right:22rpx;border:4rpx solid #FFF5C6;border-radius:50% 40% 55% 45%;box-shadow:13rpx -7rpx 0 -8rpx #FFF5C6;transform:rotate(-8deg)}.plus{width:66rpx;margin-right:20rpx;color:#E96A58;font-size:58rpx;font-weight:300;text-align:center}.creator-copy{flex:1}.creator-copy text{font-size:29rpx;font-weight:800}.creator-copy view{margin-top:5rpx;font-size:20rpx;opacity:.8}.quota{position:absolute;right:50rpx;top:18rpx;padding:5rpx 9rpx;border:1rpx solid rgba(255,255,255,.5);font-size:16rpx;transform:rotate(2deg)}.chevron{margin-left:10rpx;font-size:40rpx}.section-title{display:flex;align-items:center;margin:42rpx 5rpx 20rpx;font-size:27rpx;font-weight:800}.section-title i{flex:1;height:3rpx;margin-left:18rpx;background:#E6D4BE;transform:rotate(-1deg)}.loading{padding:50rpx;text-align:center;color:#927D6D}.plan{position:relative;display:flex;align-items:center;margin-bottom:20rpx;padding:24rpx;border:2rpx solid #E6D6C0;border-radius:24rpx 35rpx 29rpx 31rpx;background:#FFFDF6;box-shadow:0 8rpx 18rpx rgba(91,70,54,.07)}.date-stamp{width:92rpx;height:82rpx;margin-right:22rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;border:3rpx solid #E96A58;color:#C55849;transform:rotate(-3deg)}.date-stamp strong{font-size:19rpx;line-height:1}.date-stamp text{margin-top:5rpx;font-size:15rpx}.plan-copy{min-width:0;flex:1}.plan-copy .storybook-title{font-size:27rpx;font-weight:800}.plan-copy text{display:block;margin-top:6rpx;color:#927D6D;font-size:19rpx}.bar{height:8rpx;margin-top:15rpx;border-radius:8rpx;background:#EFE4D3}.bar i{display:block;height:100%;background:#F6C85F}.tag{position:absolute;right:18rpx;top:14rpx;color:#5D816F;font-size:16rpx}.draft{display:flex;justify-content:space-between;align-items:center;margin-bottom:14rpx;padding:23rpx;border-left:7rpx solid #F6C85F;background:rgba(255,253,246,.8)}.draft .storybook-title{display:block;font-size:25rpx;font-weight:700}.draft small{display:block;margin-top:5rpx;color:#927D6D}.draft>view:last-child{color:#D36756;font-size:20rpx}
