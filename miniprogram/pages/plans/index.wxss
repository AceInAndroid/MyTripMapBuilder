.page{min-height:100vh;padding:44rpx 28rpx}.header{margin:8rpx 10rpx 35rpx}.kicker{color:#C55C4D;font-size:18rpx;font-weight:800;letter-spacing:4rpx}.title{margin-top:7rpx;font-size:48rpx;font-weight:800}.subtitle{margin-top:9rpx;color:#8C7767;font-size:22rpx;line-height:1.5}.plan-hint{margin:0 10rpx 22rpx;padding:18rpx 22rpx;border:2rpx solid #E8D9C4;border-radius:18rpx;background:#FFFDF6;color:#927D6D;font-size:21rpx;line-height:1.5}.status-filter{display:flex;white-space:nowrap;margin:0 -28rpx;padding:4rpx 28rpx 12rpx}.filter{display:inline-block;margin-right:14rpx;padding:12rpx 22rpx;border-radius:999rpx;background:#F1E7D8;color:#927D6D;font-size:21rpx}.filter.active{background:#E96A58;color:#FFF}.loading{padding:70rpx 20rpx;text-align:center;color:#927D6D}.trip-card{position:relative;display:flex;align-items:stretch;min-height:190rpx;margin-bottom:20rpx;border:2rpx solid #E3D4BF;border-radius:28rpx 35rpx 25rpx 31rpx;background:#FFFDF6;box-shadow:0 8rpx 18rpx rgba(91,70,54,.07);overflow:hidden}.trip-cover{width:190rpx;min-height:190rpx;padding:20rpx;display:flex;flex-direction:column;justify-content:space-between;color:#FFF}.cover-stamp{align-self:flex-start;padding:8rpx 10rpx;border:2rpx solid rgba(255,255,255,.8);font-size:20rpx;transform:rotate(-4deg)}.cover-label{font-family:"LXGW WenKai Screen","Kaiti SC",serif;font-size:26rpx;line-height:1.25}.trip-copy{flex:1;min-width:0;padding:24rpx 48rpx 22rpx 24rpx}.status-row{display:flex;justify-content:space-between;align-items:center}.status{color:#5D816F;font-size:19rpx;font-weight:700}.countdown{color:#C55C4D;font-size:18rpx}.trip-title{margin-top:9rpx;font-size:29rpx;font-weight:800;line-height:1.3}.trip-date,.route-summary{display:block;margin-top:8rpx;color:#927D6D;font-size:20rpx;line-height:1.4}.route-summary{color:#5B4636}.progress{height:8rpx;margin-top:16rpx;border-radius:8rpx;background:#EFE4D3}.progress i{display:block;height:100%;border-radius:8rpx;background:#F6C85F}.memory{margin-top:12rpx;color:#8C7767;font-size:20rpx;line-height:1.4}.arrow{position:absolute;right:18rpx;top:50%;color:#C55C4D;font-size:42rpx;transform:translateY(-50%)}.empty-state{padding:80rpx 24rpx;text-align:center;color:#927D6D}.empty-state .storybook-title{font-size:30rpx;color:#5B4636}.empty-state text{display:block;margin-top:14rpx;font-size:21rpx}.private-gate{box-sizing:border-box;padding:220rpx 70rpx;text-align:center;color:#775F50;background:#FFF8E8}.private-gate .title{font-size:46rpx}.private-gate text{display:block;margin:24rpx 0 50rpx;font-size:25rpx}.private-gate button{color:#FFF;background:#5FAF8B}
