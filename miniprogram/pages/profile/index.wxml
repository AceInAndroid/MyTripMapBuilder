<view wx:if="{{!profile && joining}}" class="page paper-grain safe-bottom private-gate"><view class="storybook-title title">加入家庭绘本</view><text>请输入家长发给你的一次性邀请码。</text><input value="{{inviteCode}}" bindinput="inputInvite" maxlength="16" placeholder="输入邀请码"/><button bindtap="joinFamily">加入家庭</button></view><view class="page paper-grain safe-bottom" wx:if="{{profile}}">
  <view class="family-cover"><view class="sun"></view><view class="hills"></view><view class="kicker">OUR FAMILY BOOK</view><view class="storybook-title title">{{profile.familyName}}</view><view class="caption">每一次出发，都是她长大的一小页。</view></view>
  <view class="child-card"><view class="portrait"><view></view></view><view class="child-copy"><text class="label">旅行绘本的主角</text><view class="storybook-title">{{profile.childNickname}}</view><text>{{profile.childBirthday}} 出生</text></view><button bindtap="editChild">编辑</button></view>
  <view class="section-title">家庭成员</view><view class="setting"><view class="line-icon parents"></view><view class="copy"><text>父母共同编辑</text><text class="subcopy">当前 {{profile.parentCount}} 位管理员</text></view><view class="member-links"><text class="link" bindtap="inviteParent">邀请 ›</text><text class="link" bindtap="showJoin">加入 ›</text></view></view>
  <view class="section-title">绘本状态</view><view class="metrics"><view><text class="metric-number">{{profile.activeShares}}</text><text>有效分享</text></view><view><text class="metric-number">{{profile.recycleCount}}</text><text>最近删除</text></view></view>
  <view class="setting" data-message="精选照片会自动生成展示图；原图不作为完整云备份。" bindtap="showInfo"><view class="line-icon storage"></view><view class="copy"><text>照片存储</text><text class="subcopy">{{profile.storage.usedMB}} MB / {{profile.storage.limitMB}} MB</text></view><view class="link">说明 ›</view></view>
  <view class="setting" bindtap="openRecycle"><view class="line-icon bin"></view><view class="copy"><text>最近删除</text><text class="subcopy">{{profile.recycleCount}} 项 · 保留30天</text></view><view class="link">查看 ›</view></view>
  <view class="privacy">家庭内容默认私密。分享只生成精选内容快照，隐藏住宿和实时位置，并在 7 天后失效。</view>
  <view wx:if="{{editing || joining}}" class="mask" bindtap="closeOverlays"></view>
  <view wx:if="{{editing}}" class="editor"><view class="storybook-title">主角的小档案</view><label>昵称<input value="{{nickname}}" bindinput="inputNickname" maxlength="12" /></label><label>生日<picker mode="date" value="{{birthday}}" bindchange="birthdayChange"><view class="picker">{{birthday}}</view></picker></label><view class="actions"><button bindtap="cancelEdit">取消</button><button class="save" bindtap="saveChild">保存</button></view></view>
  <view wx:if="{{joining}}" class="editor"><view class="storybook-title">加入家庭绘本</view><label>邀请码<input value="{{inviteCode}}" bindinput="inputInvite" maxlength="8" placeholder="输入8位邀请码" /></label><view class="actions"><button bindtap="cancelJoin">取消</button><button class="save" bindtap="joinFamily">加入</button></view></view>
</view>
