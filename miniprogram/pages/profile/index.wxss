.page{min-height:100vh;padding:28rpx}.family-cover{position:relative;min-height:300rpx;padding:38rpx;overflow:hidden;border-radius:38rpx 50rpx 35rpx 44rpx;color:#FFFDF6;background:#5FAF8B}.kicker{font-size:17rpx;font-weight:800;letter-spacing:4rpx;opacity:.8}.title{margin-top:10rpx;font-size:49rpx;font-weight:800}.caption{margin-top:10rpx;font-size:22rpx;opacity:.85}.sun{position:absolute;right:55rpx;top:36rpx;width:84rpx;height:84rpx;border-radius:50%;background:#F6C85F}.hills{position:absolute;left:-50rpx;right:-50rpx;bottom:-80rpx;height:200rpx;border-radius:50%;background:#3F8D70;transform:rotate(-4deg)}.child-card{position:relative;z-index:2;display:flex;align-items:center;margin:-62rpx 22rpx 35rpx;padding:23rpx;border:2rpx solid #E5D5BE;border-radius:31rpx;background:#FFFDF6;box-shadow:0 10rpx 24rpx rgba(91,70,54,.12)}.portrait{width:92rpx;height:92rpx;display:flex;align-items:center;justify-content:center;border-radius:50% 47% 53% 45%;background:#FFE0D8}.portrait view{width:44rpx;height:54rpx;border:4rpx solid #B95D50;border-radius:50% 50% 45% 45%}.child-copy{min-width:0;flex:1;padding-left:20rpx}.child-copy .label{color:#D16A59;font-size:17rpx}.child-copy .storybook-title{margin:2rpx 0;font-size:31rpx;font-weight:800}.child-copy>text:last-child{color:#927D6D;font-size:19rpx}.child-card button{width:102rpx;height:56rpx;line-height:56rpx;color:#7A6656;font-size:20rpx;background:#F4EBDD}.section-title{margin:32rpx 8rpx 15rpx;font-size:25rpx;font-weight:800}.setting{display:flex;align-items:center;min-height:95rpx;margin-bottom:12rpx;padding:18rpx 22rpx;border-bottom:2rpx dashed #E5D3BD;background:rgba(255,253,246,.78)}.copy{flex:1}.copy text,.copy small{display:block}.copy text{font-size:24rpx;font-weight:700}.copy small{margin-top:4rpx;color:#927D6D;font-size:18rpx}.link{color:#C55E50;font-size:19rpx}.line-icon{width:48rpx;height:48rpx;margin-right:18rpx;border:3rpx solid #5FAF8B}.parents{border-radius:50% 50% 12rpx 12rpx}.storage{border-radius:50% 50% 8rpx 8rpx;transform:scaleY(.7)}.bin{border-radius:5rpx 5rpx 12rpx 12rpx;border-color:#E96A58}.metrics{display:flex;padding:22rpx 10rpx;border:2rpx solid #E5D4BE;border-radius:25rpx;background:#FFFDF6}.metrics view{flex:1;text-align:center}.metrics strong,.metrics text{display:block}.metrics strong{color:#D06252;font-size:36rpx}.metrics text{margin-top:5rpx;color:#927D6D;font-size:17rpx}.privacy{margin:28rpx 7rpx;padding:22rpx;color:#746153;font-size:20rpx;line-height:1.6;border-left:7rpx solid #F6C85F;background:#FFF3C9}.mask{position:fixed;z-index:1000;inset:0;background:rgba(73,55,43,.45)}.editor{position:fixed;z-index:1001;left:28rpx;right:28rpx;bottom:28rpx;padding:32rpx;border-radius:34rpx 40rpx 28rpx 36rpx;background:#FFF8E8}.editor>.storybook-title{font-size:32rpx;font-weight:800}.editor label{display:block;margin-top:24rpx;color:#8A7464;font-size:20rpx}.editor input,.picker{margin-top:8rpx;padding:20rpx;border:2rpx solid #E0CDB5;border-radius:15rpx;color:#5B4636;background:#FFFDF6}.actions{display:flex;gap:16rpx;margin-top:28rpx}.actions button{flex:1}.actions .save{color:#FFF;background:#5FAF8B}
.copy .subcopy{margin-top:4rpx;color:#927D6D;font-size:18rpx;font-weight:400}.member-links{display:flex;gap:14rpx}.metrics .metric-number{margin-top:0;color:#D06252;font-size:36rpx;font-weight:800}
.private-gate{padding:220rpx 70rpx;text-align:center;color:#775F50;background:#FFF8E8}.private-gate .title{font-size:46rpx}.private-gate text{display:block;margin:24rpx 0 50rpx;font-size:25rpx}.private-gate input{box-sizing:border-box;width:100%;padding:22rpx;border:2rpx solid #E8D9C4;border-radius:14rpx;background:#FFFDF6}.private-gate button{margin-top:35rpx;color:#FFF;background:#5FAF8B}
.review-banner{margin:0 8rpx 22rpx;padding:20rpx 24rpx;border-left:7rpx solid #F6C85F;color:#746153;background:#FFF3C9}.review-banner .storybook-title{font-size:27rpx;font-weight:800}.review-banner text{display:block;margin-top:7rpx;font-size:19rpx;line-height:1.5}
.editor input,.private-gate input{box-sizing:border-box;width:100%;height:84rpx;padding:0 22rpx;color:#5B4636;font-size:24rpx;line-height:84rpx}
.editor .picker{box-sizing:border-box;width:100%;height:84rpx;padding:0 22rpx;display:flex;align-items:center;line-height:normal}
