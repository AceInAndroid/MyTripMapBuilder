<view class="page paper-grain safe-bottom" wx:if="{{destination}}"><view class="header"><view class="kicker">DESTINATION NOTE</view><view class="storybook-title title">{{destination.name}}</view><view class="subtitle">{{destination.summary || '把想去的地方，慢慢整理成一张地图。'}}</view></view><map wx:if="{{markers.length}}" class="destination-map" latitude="{{latitude}}" longitude="{{longitude}}" scale="{{scale}}" markers="{{markers}}"></map><view class="section-title">攻略与地点</view><view wx:for="{{items}}" wx:key="id" class="item-card" data-index="{{index}}" bindtap="openLocation"><view class="item-meta"><text class="status">{{item.status === 'visited' ? '已去过' : item.status === 'planned' ? '已计划' : item.status === 'to_plan' ? '待规划' : '收集箱'}}</text><text>{{item.type}}</text></view><view class="storybook-title item-title">{{item.title}}</view><text class="item-summary">{{item.summary || item.content}}</text><text wx:if="{{item.verifyRequired}}" class="verify">出发前核验</text><text wx:if="{{item.sourceName}}" class="source">来源：{{item.sourceName}}</text></view><view wx:if="{{!items.length}}" class="empty-state">电脑端整理攻略后，这里会出现地点和笔记。</view></view>
