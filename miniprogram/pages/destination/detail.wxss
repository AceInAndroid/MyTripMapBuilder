.page{min-height:100vh;padding:44rpx 28rpx}.header{margin:8rpx 10rpx 30rpx}.kicker{color:#C55C4D;font-size:18rpx;font-weight:800;letter-spacing:4rpx}.title{margin-top:7rpx;font-size:48rpx;font-weight:800}.subtitle{margin-top:9rpx;color:#8C7767;font-size:22rpx;line-height:1.5}.destination-map{width:100%;height:420rpx;margin-bottom:30rpx;border:2rpx solid #E3D4BF;border-radius:28rpx 36rpx 25rpx 32rpx}.section-title{display:flex;align-items:center;margin:35rpx 5rpx 20rpx;font-size:27rpx;font-weight:800}.item-card{margin-bottom:18rpx;padding:23rpx;border:2rpx solid #E3D4BF;border-radius:25rpx 32rpx 24rpx 29rpx;background:#FFFDF6;box-shadow:0 8rpx 18rpx rgba(91,70,54,.07)}.item-meta{display:flex;justify-content:space-between;color:#927D6D;font-size:19rpx}.item-meta .status{color:#E96A58;font-weight:700}.item-title{margin-top:10rpx;font-size:29rpx;font-weight:800}.item-summary{display:block;margin-top:8rpx;color:#927D6D;font-size:21rpx;line-height:1.5}.verify,.source{display:block;margin-top:10rpx;color:#C55C4D;font-size:18rpx}.source{color:#B29D8B}.empty-state{padding:60rpx 20rpx;text-align:center;color:#927D6D}
