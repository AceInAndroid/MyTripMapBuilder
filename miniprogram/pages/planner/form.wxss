.page{min-height:100vh;padding:38rpx 28rpx}.header{margin:8rpx 10rpx 28rpx}.kicker{color:#C55C4D;font-size:18rpx;font-weight:800;letter-spacing:4rpx}.title{margin-top:8rpx;font-size:45rpx;font-weight:800}.subtitle{margin-top:8rpx;color:#927D6D;font-size:21rpx}.form{padding:25rpx 25rpx 10rpx;border:2rpx solid #E4D3BA;border-radius:31rpx 39rpx 27rpx 35rpx;background:#FFFDF6}.form label{display:block;margin-bottom:22rpx;color:#8A7363;font-size:19rpx}.form input,.picker{display:block;width:100%;box-sizing:border-box;margin-top:8rpx;padding:19rpx 17rpx;border:2rpx solid #E5D6C2;border-radius:14rpx;color:#5B4636;font-size:24rpx;background:#FFF8E8}.required{color:#D55E50}.date-row{display:flex;gap:18rpx}.date-row label{flex:1}.hint{margin:21rpx 8rpx;padding:20rpx;color:#806A58;font-size:19rpx;line-height:1.6;border-left:6rpx solid #F6C85F;background:#FFF3C9}.submit{margin:22rpx 8rpx 40rpx;color:#FFF;background:#5FAF8B}
