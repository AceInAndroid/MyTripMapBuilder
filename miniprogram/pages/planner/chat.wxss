.page{min-height:100vh;padding:35rpx 28rpx}.header{margin:8rpx 10rpx 24rpx}.kicker{color:#C55C4D;font-size:18rpx;font-weight:800;letter-spacing:4rpx}.title{margin-top:8rpx;font-size:42rpx;font-weight:800}.subtitle{margin-top:8rpx;color:#927D6D;font-size:20rpx}.chat{height:265rpx;padding:8rpx}.bubble{max-width:78%;margin-bottom:14rpx;padding:17rpx 20rpx;border-radius:18rpx 27rpx 21rpx 24rpx;font-size:21rpx;line-height:1.5}.bubble.assistant{margin-right:auto;color:#675547;background:#FFFDF6}.bubble.user{margin-left:auto;color:#FFF;background:#5FAF8B}.preview{margin-top:18rpx;padding:23rpx;border:2rpx solid #E4D2B8;border-radius:30rpx;background:#FFFDF6}.preview-head{display:flex;justify-content:space-between;padding-bottom:17rpx;border-bottom:2rpx dashed #E5D5C0;font-weight:800}.preview-head text:last-child{color:#927D6D;font-size:17rpx;font-weight:400}.preview-day{display:flex;gap:18rpx;padding:17rpx 0;border-bottom:2rpx dashed #E5D5C0}.preview-day strong{color:#C75E4E;font-size:20rpx}.preview-day text,.preview-day small{display:block}.preview-day text{font-size:21rpx;font-weight:700}.preview-day small{margin-top:5rpx;color:#927D6D;font-size:17rpx}.quick{display:flex;gap:10rpx;margin:18rpx 0;overflow-x:auto;white-space:nowrap}.quick text{padding:9rpx 13rpx;border-radius:20rpx;color:#8E614D;font-size:18rpx;background:#FFE7DB}.composer{display:flex;gap:10rpx}.composer input{flex:1;padding:17rpx;border:2rpx solid #E0CEB6;border-radius:20rpx;background:#FFFDF6}.composer button{width:105rpx;padding:0;color:#FFF;background:#E96A58}.confirm{margin-top:20rpx;color:#FFF;background:#5FAF8B}
