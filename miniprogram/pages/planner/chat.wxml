<view wx:if="{{trip}}" class="page paper-grain safe-bottom"><view class="header"><view class="kicker">DRAFT WORKSHOP</view><view class="storybook-title title">把路线改成我们的样子</view><view class="subtitle">聊天只改草案，确认前不会覆盖正式旅行。</view></view><scroll-view scroll-y="true" class="chat"><view wx:for="{{messages}}" wx:key="index" class="bubble {{item.role}}">{{item.text}}</view></scroll-view><view class="preview"><view class="preview-head"><text>结构化草案</text><text>{{trip.dayCount}}天 · {{trip.days.length}}个章节</text></view><view wx:for="{{trip.days}}" wx:key="id" class="preview-day"><strong>D{{item.dayNumber}}</strong><view><text>{{item.city}} · {{item.title}}</text><small>{{item.places.length}} 个地点 · {{item.drive}}</small></view></view></view><view class="quick"><text bindtap="useQuick" data-value="加入莎车">加入莎车</text><text bindtap="useQuick" data-value="减少高海拔停留">减少高海拔停留</text><text bindtap="useQuick" data-value="这天轻松一点">这天轻松一点</text></view><view class="composer"><input value="{{input}}" bindinput="input" confirm-type="send" bindconfirm="send" placeholder="告诉小帮手怎么改…" /><button bindtap="send">发送</button></view><button class="confirm" bindtap="confirm">确认，保存为计划中</button></view>
