.page{min-height:100vh;padding:35rpx 28rpx}.book{padding:34rpx 27rpx;border:2rpx solid #E2D0B7;border-radius:33rpx 44rpx 27rpx 39rpx;background:#FFFDF6}.kicker{color:#C55C4D;font-size:17rpx;font-weight:800;letter-spacing:4rpx}.title{margin-top:10rpx;font-size:43rpx;font-weight:800}.range{margin-top:7rpx;color:#927D6D;font-size:19rpx}.memory{margin:24rpx 0;padding:19rpx;color:#725D4D;font-size:22rpx;line-height:1.5;border-left:6rpx solid #F6C85F;background:#FFF3C9}.day{padding:23rpx 0;border-top:2rpx dashed #E4D4BE}.day-title{display:flex;gap:14rpx;align-items:center}.day-title strong{color:#C55D4E}.day-title text{font-size:22rpx;font-weight:800}.shared-photo{display:inline-block;width:30%;height:175rpx;margin:14rpx 2% 0 0;border-radius:10rpx;background-position:center;background-size:cover;background-color:#EDDFCE}.diary{margin-top:14rpx;color:#735F50;font-size:21rpx;line-height:1.6}.quote{margin-top:10rpx;color:#C45D50;font-weight:700}.privacy{margin-top:25rpx;color:#927D6D;font-size:18rpx;line-height:1.5}.expired{margin-top:35vh;padding:45rpx 30rpx;text-align:center;border:2rpx dashed #D8C3A8;background:#FFFDF6}.expired .storybook-title{font-size:31rpx;font-weight:800}.expired text{display:block;margin-top:13rpx;color:#927D6D;font-size:20rpx}
.shared-photo image{width:100%;height:100%}
