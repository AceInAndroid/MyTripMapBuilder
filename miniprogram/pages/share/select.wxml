<view wx:if="{{trip}}" class="page paper-grain safe-bottom"><view class="storybook-title title">选择要分享的页</view><text class="hint">住宿、实时位置和未勾选内容不会出现在分享快照里。</text><view wx:for="{{trip.days}}" wx:for-index="dayIndex" wx:key="id" class="share-day"><view class="day-title">D{{item.dayNumber}} · {{item.city}}</view><view wx:if="{{item.diary && item.diary.updatedAt}}" class="choice" data-day="{{dayIndex}}" bindtap="toggleDiary"><text class="check">{{item.shareDiary === false ? '○' : '●'}}</text><text>分享这天的日记</text></view><view wx:for="{{item.photos}}" wx:for-index="photoIndex" wx:key="id" class="choice" data-day="{{dayIndex}}" data-index="{{photoIndex}}" bindtap="togglePhoto"><text class="check">{{item.shareSelected === false ? '○' : '●'}}</text><image src="{{item.displayUrl || item.tempPath}}" mode="aspectFill"></image><text>照片{{photoIndex + 1}}</text></view></view><button class="primary" bindtap="generate">生成7天分享</button></view>
