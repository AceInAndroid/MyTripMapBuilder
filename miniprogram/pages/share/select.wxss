.page{min-height:100vh;padding:30rpx 28rpx;background:#FFF8E8;color:#5B4636}.title{font-size:42rpx}.hint{display:block;margin:14rpx 0 24rpx;color:#927D6D;font-size:20rpx}.share-day{margin:18rpx 0;padding:22rpx;border:2rpx solid #E5D2B7;border-radius:22rpx;background:#FFFDF6}.day-title{font-size:26rpx;font-weight:800}.choice{display:flex;align-items:center;gap:12rpx;margin-top:18rpx;font-size:21rpx}.check{color:#E96A58;font-size:27rpx}.choice image{width:75rpx;height:55rpx;border-radius:8rpx}.primary{margin-top:30rpx;color:#FFF;background:#5FAF8B}
