<view wx:if="{{trip}}" class="page paper-grain safe-bottom"><view wx:if="{{trip.readOnly}}" class="review-notice">审核体验 · 脱敏只读演示</view><view class="hero" style="background: {{trip.coverColor}}"><view class="stamp">{{trip.status === 'completed' ? 'MEMORY' : 'PLANNING'}}</view><view class="storybook-title title">{{trip.title}}</view><view class="range">{{trip.dateRange}} · {{trip.childAge}} · {{trip.travelers}}</view><view class="hero-label">{{trip.coverLabel}}</view></view><view class="intro"><view class="memory">“{{trip.memory}}”</view><view class="verification" wx:if="{{trip.needsVerification}}">出发前核验：开放、预约、路况与住宿政策</view></view><view class="chapter-tabs"><view class="chapter {{tab === 'route' ? 'active' : ''}}" data-tab="route" bindtap="switchTab">路线</view><view wx:if="{{trip.notes && trip.notes.length}}" class="chapter {{tab === 'notes' ? 'active' : ''}}" data-tab="notes" bindtap="switchTab">笔记</view><view class="chapter {{tab === 'photos' ? 'active' : ''}}" data-tab="photos" bindtap="switchTab">照片</view><view class="chapter {{tab === 'diary' ? 'active' : ''}}" data-tab="diary" bindtap="switchTab">日记</view></view><view wx:if="{{tab === 'route'}}" class="route"><view class="route-map-wrap"><view class="route-map-caption"><text class="storybook-title">{{routeView === 'overview' ? '路线总览' : routeViewLabel}}</text><text>点位顺序与驾驶方向示意</text></view><map class="route-map" latitude="{{routeLatitude}}" longitude="{{routeLongitude}}" scale="{{routeScale}}" include-points="{{routePoints}}" markers="{{routeMarkers}}" polyline="{{routePolylines}}" enable-traffic="false" enable-zoom="true" bindmarkertap="routeMarkerTap"></map></view><scroll-view scroll-x="true" class="day-strip"><view class="day-pill overview-pill {{routeView === 'overview' ? 'active' : ''}}" bindtap="showRouteOverview"><text>总览</text><text class="day-city">全路线</text></view><view wx:for="{{trip.days}}" wx:key="id" class="day-pill {{routeView === 'day' && selected === index ? 'active' : ''}}" data-index="{{index}}" bindtap="selectDay"><text>D{{item.dayNumber}}</text><text class="day-city">{{item.city}}</text></view></scroll-view><view class="day-heading"><view class="storybook-title">D{{trip.days[selected].dayNumber}} · {{trip.days[selected].title}}</view><text>{{trip.days[selected].distance}}</text></view><view class="drive">{{trip.days[selected].drive}}</view><view wx:if="{{trip.days[selected].warning}}" class="warning">{{trip.days[selected].warning}}</view><view wx:for="{{trip.days[selected].places}}" wx:key="id" class="place"><view class="dot">{{index + 1}}</view><view class="place-copy"><view><text class="time">{{item.time}}</text><text class="type">{{item.type}}</text></view><view class="place-name">{{item.name}}</view><view class="desc">{{item.description}}</view><view wx:if="{{item.verifyRequired}}" class="verify">待核验</view><button bindtap="navigate" data-index="{{index}}">打开导航</button></view></view><view class="actions"><button wx:if="{{trip.status !== 'completed' && !trip.readOnly}}" bindtap="markCompleted">旅行结束，收进地图</button></view></view><view wx:if="{{tab === 'notes'}}" class="notes"><view wx:for="{{trip.notes}}" wx:key="id" wx:for-item="note" class="note-card"><view class="note-region">{{note.region}} · 旅行笔记</view><view class="storybook-title note-title">{{note.title}}</view><view class="note-summary">{{note.summary}}</view><view wx:for="{{note.blocks}}" wx:key="index" wx:for-item="block" class="note-block"><view wx:if="{{block.type === 'heading'}}" class="note-heading">{{block.text}}</view><rich-text wx:elif="{{block.type === 'paragraph'}}" class="note-paragraph" nodes="{{block.html}}"></rich-text><view wx:elif="{{block.type === 'list'}}" class="note-list"><view wx:for="{{block.items}}" wx:key="*this" wx:for-item="entry" class="note-list-row"><text>•</text><text>{{entry}}</text></view></view><scroll-view wx:elif="{{block.type === 'table'}}" scroll-x="true" class="note-table-scroll"><view class="note-table"><view class="note-table-row note-table-head"><text wx:for="{{block.columns}}" wx:key="*this" wx:for-item="cell">{{cell}}</text></view><view wx:for="{{block.rows}}" wx:key="index" wx:for-item="row" class="note-table-row"><text wx:for="{{row}}" wx:key="index" wx:for-item="cell">{{cell}}</text></view></view></scroll-view><view wx:elif="{{block.type === 'callout'}}" class="note-callout {{block.tone === 'warning' ? 'warning' : ''}}">{{block.text}}</view></view><view wx:if="{{note.verifyRequired}}" class="note-verify">开放、交通、价格与预约信息请在出发前核验</view></view></view><view wx:if="{{tab === 'photos'}}" class="photos"><view class="section-title">D{{trip.days[selected].dayNumber}} 的照片</view><view class="photo-grid"><view wx:for="{{trip.days[selected].photos}}" wx:key="id" class="photo"><image src="{{item.displayUrl || item.tempPath}}" mode="aspectFill"></image><text>{{item.caption}}</text></view><view wx:if="{{!trip.readOnly}}" class="add-photo" bindtap="choosePhotos">＋<text class="add-photo-label">添加精选照片</text></view></view><view wx:if="{{uploading}}" class="upload-note">照片正在排队，网络恢复后会继续上传。</view></view><view wx:if="{{tab === 'diary'}}" class="diary"><view class="diary-paper"><view class="section-title">D{{trip.days[selected].dayNumber}} 的一天</view><view class="diary-row"><text>爸爸妈妈写</text><view>{{trip.days[selected].diary.parentNote || '还没有写下今天的故事。'}}</view></view><view class="diary-row child"><text>女儿说</text><view>{{trip.days[selected].diary.childQuote || '“今天最喜欢什么？”等她回来告诉我们。'}}</view></view><view class="diary-row"><text>今天最喜欢</text><view>{{trip.days[selected].diary.favorite || '点击编辑，留下一个小小答案。'}}</view></view><button wx:if="{{!trip.readOnly}}" bindtap="editDiary">写下今天</button></view></view><view wx:if="{{!trip.readOnly}}" class="bottom-actions"><button bindtap="shareTrip">{{shareText}}</button><button bindtap="editDiary">写日记</button></view><button wx:if="{{!trip.readOnly}}" class="delete-trip" bindtap="deleteTrip">移到最近删除</button></view>
