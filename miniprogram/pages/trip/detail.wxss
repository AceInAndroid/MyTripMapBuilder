.page{min-height:100vh;padding:26rpx 28rpx}.hero{position:relative;min-height:280rpx;padding:38rpx;border-radius:38rpx 52rpx 35rpx 44rpx;overflow:hidden;color:#5B4636}.hero::after{content:"";position:absolute;right:-25rpx;bottom:-45rpx;width:230rpx;height:230rpx;border:4rpx solid rgba(91,70,54,.2);border-radius:50%}.stamp{position:absolute;right:28rpx;top:26rpx;padding:7rpx 11rpx;border:2rpx solid rgba(91,70,54,.5);font-size:16rpx;transform:rotate(5deg)}.title{position:relative;z-index:2;margin-top:62rpx;font-size:45rpx;font-weight:800}.range{position:relative;z-index:2;margin-top:10rpx;font-size:20rpx}.hero-label{position:absolute;left:39rpx;bottom:27rpx;z-index:2;font-size:19rpx;font-weight:700}.intro{padding:23rpx 10rpx}.memory{color:#715C4D;font-size:22rpx;line-height:1.55}.verification{margin-top:13rpx;padding:12rpx 16rpx;color:#8D5D22;font-size:18rpx;background:#FFF1C5}.chapter-tabs{display:flex;border-bottom:2rpx solid #E3D3BD}.chapter{flex:1;padding:17rpx;text-align:center;color:#927D6D;font-size:24rpx}.chapter.active{color:#C85E50;font-weight:800;border-bottom:5rpx solid #FF7A66}.route-map-wrap{position:relative;margin-top:24rpx;padding:13rpx 13rpx 18rpx;border:2rpx solid #E2D0B8;border-radius:28rpx 38rpx 25rpx 32rpx;background:#FFFDF6;box-shadow:0 8rpx 0 rgba(91,70,54,.08)}.route-map-caption{display:flex;align-items:end;justify-content:space-between;padding:2rpx 9rpx 11rpx;color:#927D6D;font-size:17rpx}.route-map-caption .storybook-title{color:#5B4636;font-size:29rpx;font-weight:800}.route-map{width:100%;height:470rpx;border-radius:18rpx 25rpx 17rpx 21rpx;overflow:hidden}.day-strip{white-space:nowrap;margin:23rpx -28rpx 15rpx}.day-pill{display:inline-flex;width:105rpx;height:70rpx;margin-left:12rpx;flex-direction:column;align-items:center;justify-content:center;border:2rpx solid #E2D0B8;border-radius:19rpx 25rpx 17rpx 20rpx;background:#FFFDF6}.day-pill text{font-size:22rpx;font-weight:800}.day-pill small{margin-top:4rpx;color:#927D6D;font-size:17rpx}.day-pill.active{color:#FFF;background:#5FAF8B;border-color:#5FAF8B}.day-pill.active small{color:#E8F5EE}.day-pill.active .day-city{color:#E8F5EE}.day-heading{display:flex;align-items:end;justify-content:space-between}.day-heading .storybook-title{font-size:30rpx;font-weight:800}.day-heading>text{color:#927D6D;font-size:19rpx}.drive{margin:14rpx 0;padding:18rpx;color:#6B5748;font-size:20rpx;border-left:6rpx solid #F6C85F;background:#FFF3C9}.warning{padding:18rpx;color:#8A392E;font-size:20rpx;line-height:1.5;border:2rpx solid #F1C9BF;background:#FFF0EB}.place{display:flex;padding:22rpx 0;border-bottom:2rpx dashed #E4D4BF}.dot{width:44rpx;height:44rpx;flex:0 0 44rpx;line-height:44rpx;text-align:center;border-radius:50%;color:#FFF;background:#E96A58}.place-copy{position:relative;flex:1;padding-left:18rpx}.time{color:#C15F50;font-size:18rpx;font-weight:800}.type{margin-left:10rpx;color:#927D6D;font-size:17rpx}.place-name{margin-top:8rpx;font-size:27rpx;font-weight:800}.desc{margin-top:6rpx;color:#756457;font-size:20rpx;line-height:1.5}.verify{display:inline-block;margin-top:8rpx;padding:4rpx 9rpx;color:#A06E2C;font-size:16rpx;background:#FFF1C5}.place-copy button{display:inline-block;width:160rpx;height:52rpx;margin:14rpx 0 0;padding:0;line-height:52rpx;color:#5FAF8B;font-size:19rpx;border:2rpx solid #A7D4C1;background:transparent}.actions{display:flex;gap:14rpx;margin-top:25rpx}.actions button,.bottom-actions button{flex:1;font-size:20rpx;color:#6F5A4A;background:#F4EBDD}.actions button:last-child,.bottom-actions button:first-child{color:#FFF;background:#5FAF8B}.photo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.photo{position:relative;height:190rpx;border-radius:10rpx 17rpx 12rpx 14rpx;background-position:center;background-size:cover;background-color:#EEDFCB}.photo text{position:absolute;bottom:5rpx;left:7rpx;right:7rpx;overflow:hidden;color:#FFF;font-size:15rpx;text-shadow:0 1rpx 3rpx #000}.add-photo{display:flex;align-items:center;justify-content:center;flex-direction:column;height:190rpx;border:2rpx dashed #D7C2A7;color:#D06A59;font-size:50rpx}.add-photo small{font-size:17rpx}.upload-note{margin-top:18rpx;color:#927D6D;font-size:19rpx}.diary-paper{margin-top:24rpx;padding:29rpx;border:2rpx solid #E5D2B7;border-radius:27rpx 38rpx 24rpx 32rpx;background:#FFFDF6}.section-title{font-size:29rpx;font-weight:800}.diary-row{margin-top:25rpx;padding-bottom:18rpx;border-bottom:2rpx dashed #E4D4BF}.diary-row>text{color:#C65F50;font-size:18rpx;font-weight:800}.diary-row>view{margin-top:8rpx;color:#6C594C;font-size:23rpx;line-height:1.6}.diary-row.child{transform:rotate(-1deg)}.diary-paper button{margin-top:23rpx;color:#FFF;background:#5FAF8B}.bottom-actions{display:flex;gap:15rpx;margin-top:25rpx;padding-bottom:25rpx}.bottom-actions button{min-height:76rpx;line-height:76rpx}
.day-pill .day-city{margin-top:4rpx;color:#927D6D;font-size:17rpx}.day-pill.active .day-city{color:#E8F5EE}.photo{overflow:hidden}.photo image{width:100%;height:100%}.add-photo-label{font-size:17rpx}.delete-trip{margin:0 auto 25rpx;color:#A26C63;font-size:19rpx;background:transparent}
