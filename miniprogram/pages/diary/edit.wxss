.page{min-height:100vh;padding:38rpx 28rpx}.header{margin:8rpx 10rpx 28rpx}.kicker{color:#C55C4D;font-size:18rpx;font-weight:800;letter-spacing:4rpx}.title{margin-top:8rpx;font-size:43rpx;font-weight:800}.subtitle{margin-top:8rpx;color:#927D6D;font-size:21rpx}.paper{padding:30rpx 26rpx;border:2rpx solid #E2D0B6;border-radius:30rpx 40rpx 25rpx 35rpx;background:#FFFDF6}.paper label{display:block;margin-bottom:27rpx;color:#C55E50;font-size:21rpx;font-weight:800}.paper label>text{display:block;margin-top:4rpx;color:#927D6D;font-size:18rpx;font-weight:400}.paper textarea,.paper input{display:block;width:100%;box-sizing:border-box;margin-top:10rpx;padding:17rpx;border:0;border-bottom:2rpx dashed #E2D0B6;color:#5B4636;font-size:23rpx;line-height:1.6;background:transparent}.paper textarea{min-height:145rpx}.save{margin:28rpx 7rpx;color:#FFF;background:#5FAF8B}
