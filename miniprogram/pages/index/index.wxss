.page{min-height:100vh}.map-stage{position:relative;min-height:780rpx;overflow:hidden;background:#DCE9D7}.masthead{position:absolute;z-index:5;left:34rpx;right:34rpx;top:28rpx;pointer-events:none}.mini-title,.kicker{color:#C55C4D;font-size:18rpx;font-weight:800;letter-spacing:4rpx}.title{margin-top:4rpx;color:#4C392D;font-size:53rpx;font-weight:800}.subtitle{margin-top:4rpx;color:#775F50;font-size:22rpx}.world-map{width:100%;height:780rpx;opacity:.88}.map-tape{position:absolute;z-index:6;left:50%;bottom:62rpx;padding:13rpx 25rpx;transform:translateX(-50%) rotate(-2deg);white-space:nowrap;color:#725E4F;font-size:19rpx;background:rgba(255,242,179,.9)}.empty-footprints{position:absolute;z-index:4;left:70rpx;right:70rpx;top:310rpx;padding:30rpx;text-align:center;color:#6F5A4A;border:2rpx dashed rgba(91,70,54,.24);border-radius:48% 52% 44% 56%;background:rgba(255,248,232,.86)}.empty-footprints .storybook-title{font-size:27rpx;font-weight:700}.empty-footprints text{display:block;margin-top:8rpx;font-size:20rpx}.footprint-art{height:45rpx}.footprint-art i{display:inline-block;width:15rpx;height:23rpx;margin:0 7rpx;border:3rpx solid #E96A58;border-radius:60% 40% 55% 45%;transform:rotate(20deg)}
.journey-sheet{position:relative;z-index:10;min-height:600rpx;margin-top:-48rpx;padding:50rpx 28rpx 40rpx;border-radius:48rpx 42rpx 0 0;background:#FFF8E8;box-shadow:0 -10rpx 32rpx rgba(91,70,54,.12)}.journey-sheet::before{content:"";position:absolute;top:-9rpx;left:0;right:0;height:18rpx;background:radial-gradient(circle at 9rpx 9rpx,transparent 8rpx,#FFF8E8 9rpx);background-size:18rpx 18rpx}.sheet-pin{position:absolute;right:76rpx;top:29rpx;width:36rpx;height:9rpx;border-radius:9rpx;background:#FF7A66;transform:rotate(7deg)}.section-head{display:flex;align-items:end;justify-content:space-between;margin:0 6rpx 24rpx}.heading{margin-top:6rpx;font-size:38rpx;font-weight:800}.count{color:#927D6D;font-size:20rpx}.loading{padding:70rpx 0;text-align:center;color:#927D6D}.trip-card{position:relative;display:flex;min-height:188rpx;margin-bottom:24rpx;padding:18rpx;overflow:hidden;border:2rpx solid #E8D9C4;border-radius:27rpx 38rpx 31rpx 25rpx;background:#FFFDF6;box-shadow:0 9rpx 20rpx rgba(91,70,54,.08)}.trip-card:nth-child(even){transform:rotate(.35deg)}.cover{position:relative;width:176rpx;flex:0 0 176rpx;overflow:hidden;border-radius:20rpx 28rpx 22rpx 18rpx;color:#5B4636}.cover::after{content:"";position:absolute;right:-22rpx;bottom:-22rpx;width:85rpx;height:85rpx;border:3rpx solid rgba(91,70,54,.22);border-radius:50%}.stamp{position:absolute;top:15rpx;right:12rpx;padding:5rpx 8rpx;border:2rpx solid rgba(91,70,54,.45);font-size:15rpx;font-weight:800;transform:rotate(4deg)}.cover-line{position:absolute;left:20rpx;bottom:51rpx;width:86rpx;height:3rpx;background:rgba(91,70,54,.5);transform:rotate(-8deg)}.cover-label{position:absolute;left:18rpx;right:12rpx;bottom:18rpx;font-size:18rpx;font-weight:700}.trip-copy{min-width:0;flex:1;padding:7rpx 34rpx 3rpx 22rpx}.status-row{display:flex;align-items:center;justify-content:space-between}.status{padding:5rpx 11rpx;border-radius:10rpx;color:#885248;font-size:17rpx;font-weight:800;background:#FFE2DC}.status-completed .status{color:#2F6F5C;background:#DDEFE7}.countdown{color:#C05D4E;font-size:18rpx}.trip-title{margin-top:12rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:29rpx;font-weight:800}.trip-date{margin-top:6rpx;color:#927D6D;font-size:19rpx}.progress{height:9rpx;margin-top:18rpx;overflow:hidden;border-radius:9rpx;background:#EFE5D7}.progress i{display:block;height:100%;background:#F6C85F}.memory{margin-top:12rpx;color:#7C6859;font-size:19rpx;line-height:1.45}.arrow{position:absolute;right:18rpx;top:77rpx;color:#B7A392;font-size:42rpx}.empty-book{padding:60rpx 30rpx;text-align:center;border:2rpx dashed #D9C8B2;border-radius:30rpx}.empty-book .storybook-title{font-size:33rpx;font-weight:800}.empty-book text{display:block;margin:13rpx 0 26rpx;color:#8B7464;font-size:22rpx}.empty-book button{width:230rpx;color:#FFF;background:#5FAF8B}.sync-note{margin:30rpx 10rpx 0;text-align:center;color:#A18E7E;font-size:18rpx}
.sync-error{margin:12rpx 10rpx 0;padding:14rpx 18rpx;color:#8A3F35;font-size:18rpx;line-height:1.45;word-break:break-all;border-radius:14rpx;background:#FFE7E1}
